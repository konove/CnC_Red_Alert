#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Puts Prettier on PATH, or fails. Processes that never read ~/.zshrc, such as
# an IDE started from the desktop, lack nvm's PATH, so fall back to the newest
# nvm-installed Node that has Prettier; its bin also supplies the node that
# Prettier's shebang needs.
find_prettier() {
  command -v prettier >/dev/null 2>&1 && return 0
  local bins=("${NVM_DIR:-$HOME/.nvm}"/versions/node/v*/bin) bin
  while IFS= read -r bin; do
    if [[ -x "$bin/prettier" ]]; then
      PATH="$bin:$PATH"
      return 0
    fi
  done < <(printf '%s\n' "${bins[@]}" | sort -rV)
  return 1
}

failed=0
while IFS= read -r -d '' file; do
  [[ "$file" == *.md ]] || continue

  if ! find_prettier; then
    echo 'Markdown check requires Prettier, on PATH or in an nvm-installed Node. Run: npm install --global prettier@3.6.2' >&2
    exit 1
  fi

  # Check the index, including partial staging, without modifying any files.
  # stdin-filepath lets Prettier apply the repository config and ignore rules.
  if ! git show ":$file" | prettier --check --stdin-filepath "$file"; then
    printf 'Markdown formatting check failed: %s\n' "$file" >&2
    failed=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if (( failed )); then
  echo 'Format the listed files with Prettier, stage the fixes, and commit again.' >&2
  exit 1
fi
