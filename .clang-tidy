---
Checks: '*,
         -altera-id-dependent-backward-branch,
         -altera-struct-pack-align,
         -altera-unroll-loops,
         -android-cloexec-accept,
         -android-cloexec-fopen,
         -android-cloexec-open,
         -android-cloexec-socket,
         -boost-use-ranges,
         -bugprone-copy-constructor-mutates-argument,
         -bugprone-easily-swappable-parameters,
         -bugprone-signed-bitwise,
         -cert-arr39-c,
         -cert-err33-c,
         -cert-exp42-c,
         -cert-oop54-cpp,
         -clang-analyzer-core.FixedAddressDereference,
         -clang-diagnostic-covered-switch-default,
         -clang-diagnostic-exit-time-destructors,
         -clang-diagnostic-global-constructors,
         -clang-diagnostic-lifetime-safety-invalidation,
         -clang-diagnostic-nested-anon-types,
         -clang-diagnostic-nullability-extension,
         -clang-diagnostic-padded,
         -clang-diagnostic-pre-c++17-compat,
         -clang-diagnostic-pre-c++20-compat,
         -clang-diagnostic-pre-c++23-compat,
         -clang-diagnostic-switch-enum,
         -clang-diagnostic-unsafe-buffer-usage,
         -clang-diagnostic-weak-vtables,
         -cppcoreguidelines-avoid-c-arrays,
         -cppcoreguidelines-avoid-const-or-ref-data-members,
         -cppcoreguidelines-avoid-do-while,
         -cppcoreguidelines-avoid-magic-numbers,
         -cppcoreguidelines-avoid-non-const-global-variables,
         -cppcoreguidelines-c-copy-assignment-signature,
         -cppcoreguidelines-explicit-virtual-functions,
         -cppcoreguidelines-init-variables,
         -cppcoreguidelines-macro-to-enum,
         -cppcoreguidelines-macro-usage,
         -cppcoreguidelines-narrowing-conversions,
         -cppcoreguidelines-non-private-member-variables-in-classes,
         -cppcoreguidelines-owning-memory,
         -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
         -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
         -cppcoreguidelines-pro-bounds-constant-array-index,
         -cppcoreguidelines-pro-bounds-pointer-arithmetic,
         -cppcoreguidelines-pro-type-union-access,
         -cppcoreguidelines-use-enum-class,
         -fuchsia-default-arguments-calls,
         -fuchsia-default-arguments-declarations,
         -fuchsia-multiple-inheritance,
         -fuchsia-overloaded-operator,
         -fuchsia-statically-constructed-objects,
         -fuchsia-trailing-return,
         -google-default-arguments,
         -google-readability-todo,
         -hicpp-avoid-c-arrays,
         -hicpp-braces-around-statements,
         -hicpp-explicit-conversions,
         -hicpp-function-size,
         -hicpp-multiway-paths-covered,
         -hicpp-named-parameter,
         -hicpp-no-array-decay,
         -hicpp-no-malloc,
         -hicpp-signed-bitwise,
         -hicpp-uppercase-literal-suffix,
         -hicpp-use-auto,
         -hicpp-use-equals-default,
         -hicpp-use-equals-delete,
         -hicpp-vararg,
         -llvm-else-after-return,
         -llvm-header-guard,
         -llvm-include-order,
         -llvm-prefer-static-over-anonymous-namespace,
         -llvm-qualified-auto,
         -llvm-use-ranges,
         -llvmlibc-callee-namespace,
         -llvmlibc-implementation-in-namespace,
         -llvmlibc-inline-function-decl,
         -llvmlibc-restrict-system-libc-headers,
         -misc-multiple-inheritance,
         -misc-no-recursion,
         -misc-non-private-member-variables-in-classes,
         -misc-use-anonymous-namespace,
         -modernize-avoid-c-arrays,
         -modernize-macro-to-enum,
         -modernize-use-designated-initializers,
         -modernize-use-std-format,
         -modernize-use-std-print,
         -modernize-use-trailing-return-type,
         -modernize-use-using,
         -performance-enum-size,
         -portability-template-virtual-member-function,
         -readability-function-cognitive-complexity,
         -readability-identifier-length,
         -readability-magic-numbers,
         -readability-trailing-comma,
         '
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/CnC_Red_Alert/src/(base|port|sdllib|tech|jshell|winvq|ra|td)/.*'
FormatStyle: file
CheckOptions:
  # glibc spells POSIX declarations through private headers: htonl and in_addr
  # through <netinet/in.h> instead of <arpa/inet.h>, SOL_SOCKET through
  # <asm-generic/socket.h>, timeval through <bits/types/struct_timeval.h>. The
  # portable spellings the Windows/macOS branches share stay as written.
  misc-include-cleaner.IgnoreHeaders: 'asm-generic/.*;bits/.*;arpa/inet\.h;netinet/in\.h;sys/time\.h'
  # Types have no `static`: the only way to give a .cc-local struct or enum
  # internal linkage is an anonymous namespace, which the codebase does not use
  # (misc-use-anonymous-namespace stays excluded). Functions and variables are
  # still checked.
  misc-use-internal-linkage.AnalyzeTypes: false
  # glibc's list adds exit, whose only hazard is two threads exiting at once;
  # the game exits from the main thread. Everything the code used from that
  # list (glob, gethostbyname) is gone anyway; the POSIX list keeps strtok,
  # rand, getenv, inet_ntoa, localtime and strerror out.
  concurrency-mt-unsafe.FunctionSet: posix
  # google-runtime-int names the <cstdint> spelling (int64_t, not int64) in its
  # suggestions.
  google-runtime-int.TypeSuffix: '_t'
  # Google style allows pointers and integers as conditions (`if (ptr)`,
  # `while (count)`); every other bool/int crossing must be explicit.
  readability-implicit-bool-conversion.AllowPointerConditions: true
  readability-implicit-bool-conversion.AllowIntegerConditions: true
  # LLVM 23 reports pointers written through `*p++ = value`, arrays of
  # pointers used to call non-const members and parameters of functions whose
  # address is taken as pointee-const; their fix-its do not compile. Locals,
  # references and values are still checked.
  misc-const-correctness.WarnPointersAsPointers: false
  # Same-width unsigned-to-signed conversions are the game's own compact types
  # flowing into int -- LEPTON (uint16_t), COORDINATE (uint32_t) and the
  # rest of the do-not-touch list in docs/TYPE_MIGRATION.md. Warning on those is
  # 585 findings the project has already decided against; real narrowing is not
  # affected.
  bugprone-narrowing-conversions.WarnOnEquivalentBitWidth: false
  # The engine's singleton globals allocate while constructing: screen buffers,
  # the dynamic vectors behind the trigger and player lists, the INI parsers,
  # the network managers and the map/display chain that owns them. They are
  # defined once per game in globals.cc and their construction order is load
  # bearing, so they cannot become function-local statics. Every other static
  # object -- the whole game-data type table -- is nothrow constructible, and
  # the check still guards a static of any type not named here.
  bugprone-throwing-static-initialization.AllowedTypes: 'BaseClass;CCINIClass;ChronalVortexClass;CreditClass;DynamicVectorClass<.*>;GameOptionsClass;GraphicBufferClass;GraphicViewPortClass;IPXManagerClass;LayerClass;LogicClass;MapEditClass;MessageListClass;MissionControlClass;GameFile;MonoClass;NullModemClass;RulesClass;ScenarioClass;SessionClass;TcpipManagerClass;TextBlitClass;ThemeClass;VersionClass;WWKeyboardClass'
  # cert-err58-cpp is the same check under another name and needs its own
  # copy of the list.
  cert-err58-cpp.AllowedTypes: 'BaseClass;CCINIClass;ChronalVortexClass;CreditClass;DynamicVectorClass<.*>;GameOptionsClass;GraphicBufferClass;GraphicViewPortClass;IPXManagerClass;LayerClass;LogicClass;MapEditClass;MessageListClass;MissionControlClass;GameFile;MonoClass;NullModemClass;RulesClass;ScenarioClass;SessionClass;TcpipManagerClass;TextBlitClass;ThemeClass;VersionClass;WWKeyboardClass'
