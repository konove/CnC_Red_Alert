# embed_file(<target> <file> <variable>)
#
# Compiles <file>, a path relative to the current source directory, into
# <target> as a header the target's sources include as
#
#   #include "embedded/<variable>.h"
#
# which defines `inline constexpr std::array<uint8_t, N> embedded::<variable>`
# holding the file's bytes. For small binary assets a program needs without a
# file to read them from, such as the window icon. (C23's #embed would do
# this, but GCC 13 has no C++ support for it.)
#
# The header is written at configure time, and only when its contents change,
# so an unchanged file rebuilds nothing; editing the file reconfigures.
function(embed_file TARGET FILE VARIABLE)
    set(_input "${CMAKE_CURRENT_SOURCE_DIR}/${FILE}")
    set(_include_dir "${CMAKE_CURRENT_BINARY_DIR}/embedded_include")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_input}")

    file(READ "${_input}" _hex HEX)
    string(LENGTH "${_hex}" _hex_length)
    math(EXPR _size "${_hex_length} / 2")
    # Twelve bytes to a line, each written 0xNN.
    string(REGEX REPLACE "(........................)" "\\1\n" _hex "${_hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " _hex "${_hex}")
    string(REGEX REPLACE ", \n" ",\n    " _hex "${_hex}")
    string(STRIP "${_hex}" _hex)

    file(RELATIVE_PATH _source "${CMAKE_SOURCE_DIR}" "${_input}")
    file(CONFIGURE OUTPUT "${_include_dir}/embedded/${VARIABLE}.h"
            CONTENT [[
// Generated by cmake/EmbedFile.cmake from @_source@. Do not edit.
#pragma once

#include <array>
#include <cstdint>

namespace embedded {

inline constexpr std::array<uint8_t, @_size@> @VARIABLE@ = {
    @_hex@
};

}  // namespace embedded
]]
            @ONLY)
    target_include_directories(${TARGET} PRIVATE "${_include_dir}")
endfunction()
